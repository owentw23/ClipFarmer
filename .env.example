# Storage & Database (keep outside OneDrive to avoid sync locks)
CLIPS_STORE_ROOT=C:\Users\wirya\Documents\Clips_Store
RAW_RECORDINGS_DIR=C:\Users\wirya\Documents\Clips_Store\raw recordings
DRAFTS_DIR=C:\Users\wirya\Documents\Clips_Store\drafts
NEONCLIPPING_DATA_DIR=C:\Users\wirya\Documents\Clips_Store\neon_tmp
DB_PATH=C:\Users\wirya\Documents\Clips_Store\db\pipeline.sqlite3

# NeonClipping Runtime
NEONCLIPPING_PORT=8770
NEONCLIPPING_NO_AUTOUPDATE=1

# LLM Configuration (BytePlus ModelArk standard endpoint)
# WARNING: Do NOT use BytePlus ModelArk Coding Plan (/api/coding/v3) for non-coding automation.
LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
LLM_MODEL=deepseek-v4-1-flash-economy-261017
LLM_API_KEY=

NEONCLIPPING_LLM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
NEONCLIPPING_LLM_MODEL=deepseek-v4-1-flash-economy-261017
NEONCLIPPING_LLM_KEY=

# Twitch API
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Google Drive OAuth (separate 5TB Google Account)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google-drive/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Token Encryption (Fernet key; auto-generated in .env)
TOKEN_ENCRYPTION_KEY=

# Frontend
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Recording & Pipeline Defaults
CHUNK_DURATION_SECONDS=7200
MIN_STANDALONE_CHUNK_SECONDS=3600
VLM_MIN_SCORE=5.0
